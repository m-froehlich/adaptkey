    <!-- D-337: the bold border drawn around the Shift key while Caps Lock is engaged - the app's own dark
         accent blue, distinct from key_background_pressed's own light-blue fill (the brief press flash) so a
         persistent lock reads differently from a momentary tap. -->
    <color name="caps_lock_border">#1565C0</color>
    <!-- D-247: a plain, fixed green for the "Gelernt: X" chip and its own shallow "Vergessen" drag zone -
         deliberately independent of the user-configurable C-04/S-05 highlight colour (settings.highlightColor
         could be set to any of the other presets), reusing D-241's own device-confirmed-distinguishable
         Material Green 600 shade as a fixed value, not a reference to the setting. -->
    <color name="suggestion_learned_text">#43A047</color>
    <color name="suggestion_forget_background">#43A047</color>
    <color name="suggestion_forget_text">#FFFFFF</color>
    <!-- D-318: the emoji-search query chip (what has been typed so far) - reuses key_hint's own muted grey,
         the same shade already used elsewhere for "context, not a value" text, so it reads as informational
         rather than another tappable emoji. -->
    <color name="suggestion_search_query_text">#7A7E83</color>
    <!-- D-362: the animated loading-placeholder chip - a warm, saturated amber (Material Amber 700) reading
         clearly as "in progress", deliberately its own colour rather than reusing suggestion_verbatim_text's
         blue (already means "keep as typed") or suggestion_search_query_text's muted grey (too subtle, the
         whole reason this bullet existed). -->
    <color name="suggestion_loading_text">#F57C00</color>
</resources>
