<?xml version="1.0" encoding="utf-8"?>
<!-- D-433-followup (v3): reuses AndroidX's own real default preference layout verbatim via <include>,
     instead of v1/v2's own hand-copied re-declaration of its icon/title/margin structure - that approach
     kept diverging in ways hard to fully reason about without a device to test against, and the root cause
     of v2's own regression (completely flush left, title not bold) turned out to be more fundamental than a
     wrong attribute value: re-declaring android:id="@+id/icon_frame" in this app's own layout XML mints a
     NEW resource id under this app's own R class - a different numeric value than
     androidx.preference.R.id.icon_frame, which is what Preference.onBindViewHolder() itself is compiled to
     look up internally to manage that view's visibility. Same name, different id - the library's own
     icon-frame handling silently never reached this layout's view at all. Including the library's own
     preference.xml directly sidesteps this whole class of bug: it is the literal same layout resource
     androidx.preference.Preference itself already renders for every other row in this screen, ids and all,
     so title/icon/summary are now guaranteed byte-identical to every sibling preference. Only the two-button
     row below it is this project's own content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
>
    <include layout="@layout/preference" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
    >

        <Button
            android:id="@+id/tier3_pref_learn_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingLeft="0dp"
            android:gravity="start|center_vertical"
            android:text="@string/d89_learn_more"
            android:textColor="@color/link_text"
        />

        <Button
            android:id="@+id/tier3_pref_setup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="0dp"
            android:paddingRight="0dp"
            android:gravity="end|center_vertical"
            android:textColor="?android:attr/textColorPrimary"
        />

    </LinearLayout>

</LinearLayout>
