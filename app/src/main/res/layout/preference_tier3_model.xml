<?xml version="1.0" encoding="utf-8"?>
<!-- D-433-followup (v4): v3's own <include> pointed at the wrong layout - @layout/preference is the plain,
     pre-Material default; this app's theme sets preferenceTheme="@style/PreferenceThemeOverlay", which maps
     preferenceStyle to Preference.Material, whose own android:layout is @layout/preference_material (a
     genuinely different file: theme-derived listPreferredItemPadding*, textAppearanceListItem for the
     title, not textAppearanceLarge) - confirmed by reading the actual style chain inside the
     androidx.preference AAR, not guessed a second time. This is the literal layout every sibling plain
     Preference in this screen already renders through, so including it here finally guarantees byte-identical
     title/icon/summary rendering. Only the two-button row below it is this project's own content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
>
    <include layout="@layout/preference_material" />

    <!-- Uses the same theme-derived paddingStart/End the included preference_material.xml's own root uses
         for its title/summary column, rather than a hard-coded dp value, so both buttons line up exactly
         under that text on any device/density instead of merely approximating it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="8dp"
    >

        <Button
            android:id="@+id/tier3_pref_learn_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingLeft="0dp"
            android:gravity="start|center_vertical"
            android:text="@string/d89_learn_more"
            android:textColor="@color/link_text"
        />

        <Button
            android:id="@+id/tier3_pref_setup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="0dp"
            android:paddingRight="0dp"
            android:gravity="end|center_vertical"
            android:textColor="?android:attr/textColorPrimary"
        />

    </LinearLayout>

</LinearLayout>
