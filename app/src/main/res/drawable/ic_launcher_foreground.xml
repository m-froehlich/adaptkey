<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- D-322: card size reverted from D-321's 66x66dp square (Google's documented adaptive-icon safe
         zone) back to the original 46x46 - real-device evidence (a file manager's own APK-icon preview)
         showed the larger card's corners clipped by that renderer's own circular crop, which apparently
         honours a 66dp-diameter *circle*, not the documented *square* - see AdaptKey-History.md D-322. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,31 L68,31 A9,9 0 0 1 77,40 L77,68 A9,9 0 0 1 68,77 L40,77 A9,9 0 0 1 31,68 L31,40 A9,9 0 0 1 40,31 Z" />
    <!-- Bold "A", same colour as the background so it reads as engraved into the white keycap. -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M57,38 L74,70 L69,70 L59,58 L55,58 L45,70 L40,70 Z" />
    <!-- Touch-zone halo, same hue as AdaptKeyboardView.kt's real touchModelFillPaint/touchModelStrokePaint
         (0,121,107 / #00796B, D-24), alpha boosted for contrast against this icon's own dark background -
         the real in-app overlay is only ever drawn over a light keyboard background. Bleeds left past the
         card's own edge on purpose (the T-03/T-05 mistouch scenario), drawn on top of the letter to match
         AdaptKeyboardView.onDraw()'s real z-order (key/label first, touch-model overlay on top). -->
    <path
        android:fillColor="#00796B"
        android:fillAlpha="0.588"
        android:strokeColor="#00796B"
        android:strokeAlpha="0.902"
        android:strokeWidth="1.8"
        android:pathData="M22,55 A22,13 0 1,0 66,55 A22,13 0 1,0 22,55 Z" />
    <!-- Strike-point dot, deliberately at the keycap's own true centre (54,54) - "central on the key" -
         not centred in the halo above, unlike drawTouchModel()'s own same-centre pairing. -->
    <path
        android:fillColor="#D32F2F"
        android:fillAlpha="0.878"
        android:pathData="M49.8,54 A4.2,4.2 0 1,0 58.2,54 A4.2,4.2 0 1,0 49.8,54 Z" />
</vector>
